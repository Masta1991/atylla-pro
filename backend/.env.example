SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...  # service_role secret
SUPABASE_ANON_KEY=eyJhbGciOi...      # anon public key

# Optional stable server-only secret for signed 72-hour inactivity leases.
# When empty, derives a separate signing key from SUPABASE_SERVICE_KEY.
# Changing either effective signing secret requires users to log in again.
AUTH_SESSION_SECRET=
