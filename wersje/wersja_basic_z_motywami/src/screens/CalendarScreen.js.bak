import React, { useState, useEffect, useCallback, useRef, useMemo } from 'react';
import { View, Text, TouchableOpacity, ScrollView, StyleSheet, Alert, useWindowDimensions, Platform, PanResponder } from 'react-native';
import { Ionicons, MaterialCommunityIcons } from '@expo/vector-icons';
import { COLORS } from '../assets/theme';
import * as api from '../services/api';
import { useTheme } from '../context/ThemeContext';

function getMonday(date) { const d = new Date(date); const day = d.getDay(); const diff = d.getDate() - day + (day === 0 ? -6 : 1); d.setDate(diff); d.setHours(0, 0, 0, 0); return d; }
function isSameWeek(d1, d2) { return getMonday(d1).getTime() === getMonday(d2).getTime(); }

const DAYS = ['Pon', 'Wt', 'Śr', 'Czw', 'Pt', 'Sob'];
const HOURS = Array.from({ length: 16 }, (_, i) => i + 6);
const MONTHS = ['Styczeń','Luty','Marzec','Kwiecień','Maj','Czerwiec','Lipiec','Sierpień','Wrzesień','Październik','Listopad','Grudzień'];
const HOUR_W = 50;
const CELL_H = 56;

function MonthPopup({ visible, onClose, currentMonday, onSelect, accent, styles }) {
  const mon = new Date(currentMonday);
  const [year, setYear] = useState(mon.getFullYear()); const [month, setMonth] = useState(mon.getMonth()); const today = new Date();
  const daysInMonth = new Date(year, month + 1, 0).getDate(); const firstDayOfWeek = (new Date(year, month, 0).getDay() + 1) % 7;
  const weeks = []; let day = 1;
  for (let w = 0; w < 6; w++) { const week = []; for (let d = 0; d < 7; d++) { if ((w === 0 && d < firstDayOfWeek) || day > daysInMonth) week.push(null); else week.push(day++); } if (week.some(d => d !== null)) weeks.push(week); }
  if (!visible) return null;
  return (<View style={styles.popupOverlay}><TouchableOpacity style={StyleSheet.absoluteFill} activeOpacity={1} onPress={onClose} /><View style={styles.popupCard}><View style={styles.popupNav}><TouchableOpacity onPress={() => month > 0 ? setMonth(month - 1) : (setMonth(11), setYear(year - 1))}><Ionicons name="chevron-back" size={18} color={accent} /></TouchableOpacity><Text style={[styles.popupMonth,{color:accent}]}>{MONTHS[month]} {year}</Text><TouchableOpacity onPress={() => month < 11 ? setMonth(month + 1) : (setMonth(0), setYear(year + 1))}><Ionicons name="chevron-forward" size={18} color={accent} /></TouchableOpacity></View><View style={styles.popupWeekdays}>{['Pn','Wt','Śr','Czw','Pt','Sob','Nd'].map(d => <Text key={d} style={styles.popupWd}>{d}</Text>)}</View>{weeks.map((week, wi) => (<View key={wi} style={styles.popupWeek}>{week.map((d, di) => { const isToday = d && year === today.getFullYear() && month === today.getMonth() && d === today.getDate(); const selMonday = d ? getMonday(new Date(year, month, d)) : null; const isSelected = selMonday && selMonday.getTime() === mon.getTime(); return (<TouchableOpacity key={di} style={[styles.popupDay, isToday && styles.popupToday, isSelected && styles.popupSelected]} onPress={() => d && (onSelect(getMonday(new Date(year, month, d))), onClose())} disabled={!d}>{d ? <Text style={[styles.popupDayText, isToday && styles.popupTodayText, isSelected && styles.popupSelectedText]}>{d}</Text> : <View />}</TouchableOpacity>); })}</View>))}</View></View>);
}

function CalendarSlot({ dateStr, hour, ev, dayW, editMode, navigation, onDelete, onDragStart, onDragMove, onDrop, onSlotLayout, isDragged, isDragOver, accent, styles }) {
  const slotRef = useRef(null);
  const editModeRef = useRef(editMode); const evRef = useRef(ev); const onDragStartRef = useRef(onDragStart); const onDragMoveRef = useRef(onDragMove); const onDropRef = useRef(onDrop);
  editModeRef.current = editMode; evRef.current = ev; onDragStartRef.current = onDragStart; onDragMoveRef.current = onDragMove; onDropRef.current = onDrop;
  const handleLayout = useCallback(() => { if (!slotRef.current) return; if (Platform.OS === 'web') { if (slotRef.current.getBoundingClientRect) { const r = slotRef.current.getBoundingClientRect(); onSlotLayout(dateStr, hour, { x: r.x, y: r.y, w: r.width, h: r.height }); } } else if (slotRef.current.measureInWindow) { slotRef.current.measureInWindow((x, y, width, height) => { onSlotLayout(dateStr, hour, { x, y, w: width, h: height }); }); } }, [dateStr, hour, onSlotLayout]);
  const panResponder = useRef(PanResponder.create({ onStartShouldSetPanResponder: () => false, onMoveShouldSetPanResponder: (_, gs) => editModeRef.current && !!evRef.current && (Math.abs(gs.dx) > 5 || Math.abs(gs.dy) > 5), onPanResponderGrant: (e, gs) => { onDragStartRef.current(dateStr, hour, evRef.current, gs.moveX, gs.moveY); }, onPanResponderMove: (e, gs) => { onDragMoveRef.current(gs.moveX, gs.moveY); }, onPanResponderRelease: (e, gs) => { onDropRef.current(gs.moveX, gs.moveY); }, onPanResponderTerminate: () => { onDropRef.current(-1, -1); } })).current;
  const handleTap = useCallback(() => {
    if (editMode) {
      if (ev) {
        const doDelete = () => onDelete(dateStr, hour, ev);
        if (Platform.OS === 'web') {
          if (window.confirm('Czy na pewno chcesz usunąć dany zapis?')) {
            doDelete();
          }
        } else {
          Alert.alert('Usuń zapis', 'Czy na pewno chcesz usunąć dany zapis?', [
            { text: 'Anuluj', style: 'cancel' },
            { text: 'Usuń', style: 'destructive', onPress: doDelete },
          ]);
        }
      }
    } else {
      navigation.navigate('Training', { date: dateStr, hour });
    }
  }, [editMode, ev, dateStr, hour, navigation, onDelete]);
  return (<View ref={slotRef} onLayout={handleLayout} style={[styles.slot, ev && { backgroundColor: accent + '15', borderColor: accent + '30' }, { width: dayW - 2 }, isDragged && { opacity: 0.3 }, isDragOver && { borderColor: accent, borderWidth: 2, backgroundColor: accent + '25' }]} dataSet={{ slotDate: dateStr, slotHour: String(hour) }} {...(editMode && ev ? panResponder.panHandlers : {})}><TouchableOpacity style={{ flex: 1, width: '100%', justifyContent: 'center', alignItems: 'center' }} activeOpacity={editMode && ev ? 1 : 0.7} onPress={handleTap}>{ev ? <Text style={[styles.eventText,{color:accent}]} numberOfLines={3}>{ev.clients?.name || '—'}{ev.workout_types?.name ? '\n' + ev.workout_types.name : ''}</Text> : null}</TouchableOpacity></View>);
}

function CalendarScreen({ navigation }) {
  const { colors: C } = useTheme();
  const styles = useMemo(() => makeStyles(C.accent), [C.accent]);
  const today = new Date();
  const [monday, setMonday] = useState(getMonday(today));
  const [events, setEvents] = useState([]);
  const [editMode, setEditMode] = useState(false);
  const [showMonth, setShowMonth] = useState(false);
  const [viewMode, setViewMode] = useState('week');
  const { width: SCREEN_WIDTH } = useWindowDimensions();
  const dayW = viewMode === 'week' ? (SCREEN_WIDTH - HOUR_W) / 3 : (SCREEN_WIDTH - HOUR_W);
  const headerScrollRef = useRef(null);
  const isCurrentWeek = isSameWeek(monday, today);
  const weekLabel = monday.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  const saturdayLabel = new Date(monday.getTime() + 5 * 86400000).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  const loadWeek = useCallback(async () => { try { const data = await api.getWeekEvents(monday.toISOString().slice(0, 10)); setEvents(data || []); } catch (e) {} }, [monday]);
  useEffect(() => { loadWeek(); }, [loadWeek]);
  const nextWeek = () => setMonday(new Date(monday.getTime() + 7 * 86400000));
  const prevWeek = () => setMonday(new Date(monday.getTime() - 7 * 86400000));
  const goToday = () => setMonday(getMonday(today));
  const [draggedSlot, setDraggedSlot] = useState(null);
  const [dragOver, setDragOver] = useState(null);
  const ghostRef = useRef(null);
  const slotLayoutsRef = useRef({});
  const isDragging = draggedSlot !== null;
  const vScrollRef = useRef(null); const hGridRef = useRef(null); const gridBoxRef = useRef(null);
  const gridOriginX = useRef(0); const gridOriginY = useRef(0); const scrollX = useRef(0); const scrollY = useRef(0); const autoTimer = useRef(null);
  const registerSlotLayout = useCallback((date, hour, rect) => { slotLayoutsRef.current[date+'|'+hour] = { x: rect.x, y: rect.y, w: rect.w, h: rect.h }; }, []);
  const findDropTarget = useCallback((x, y) => { const ox = gridOriginX.current, oy = gridOriginY.current, sx = scrollX.current, sy = scrollY.current; if (!ox && !oy) { for (const [key, rect] of Object.entries(slotLayoutsRef.current)) { if (x >= rect.x && x <= rect.x + rect.w && y >= rect.y && y <= rect.y + rect.h) return key; } return null; } const col = Math.floor((x - ox + sx) / dayW); const row = Math.floor((y - oy + sy) / CELL_H); if (col < 0 || col >= DAYS.length || row < 0 || row >= HOURS.length) return null; const date = new Date(monday.getTime() + col * 86400000); return date.toISOString().slice(0, 10)+'|'+HOURS[row]; }, [dayW, monday]);
  const measureGrid = useCallback(() => { try { if (gridBoxRef.current?.measureInWindow) { gridBoxRef.current.measureInWindow((x, y) => { if (typeof x === 'number') gridOriginX.current = x; if (typeof y === 'number') gridOriginY.current = y; }); } } catch (e) {} }, []);
  useEffect(() => { const t = setTimeout(measureGrid, 300); return () => clearTimeout(t); }, [measureGrid]);
  const stopAutoScroll = useCallback(() => { if (autoTimer.current) { try { if (typeof cancelAnimationFrame === 'function') cancelAnimationFrame(autoTimer.current); } catch (e) {} try { clearInterval(autoTimer.current); } catch (e) {} autoTimer.current = null; } }, []);
  const startAutoScroll = useCallback((dirX, dirY, step) => { stopAutoScroll(); const tick = () => { if (dirX > 0) scrollX.current = Math.min(scrollX.current + step, DAYS.length * dayW - SCREEN_WIDTH + HOUR_W); else if (dirX < 0) scrollX.current = Math.max(0, scrollX.current - step); if (dirY > 0) scrollY.current = Math.min(scrollY.current + step, HOURS.length * CELL_H - 200); else if (dirY < 0) scrollY.current = Math.max(0, scrollY.current - step); try { hGridRef.current?.scrollTo?.({ x: scrollX.current, animated: false }); } catch (e) {} try { vScrollRef.current?.scrollTo?.({ y: scrollY.current, animated: false }); } catch (e) {} }; tick(); if (typeof requestAnimationFrame === 'function') { autoTimer.current = requestAnimationFrame(function loop() { tick(); autoTimer.current = requestAnimationFrame(loop); }); } else { autoTimer.current = setInterval(tick, 16); } }, [stopAutoScroll, SCREEN_WIDTH, dayW]);
  const handleDragStart = useCallback((date, hour, ev, x, y) => { setDraggedSlot({ date, hour, ev, x, y }); }, []);
  const handleDragMove = useCallback((x, y) => { if (Platform.OS === 'web' && ghostRef.current) { ghostRef.current.style.left = (x + 12)+'px'; ghostRef.current.style.top = (y + 12)+'px'; } const targetKey = findDropTarget(x, y); setDragOver(targetKey); const edge = 50; const step = 10; let dirX = 0, dirY = 0; if (x > SCREEN_WIDTH - edge && scrollX.current < DAYS.length * dayW - SCREEN_WIDTH + HOUR_W) dirX = 1; else if (x < edge && scrollX.current > 0) dirX = -1; if (y > (typeof window !== 'undefined' ? window.innerHeight : 700) - edge) dirY = 1; else if (y < edge + 140) dirY = -1; if (dirX !== 0 || dirY !== 0) startAutoScroll(dirX, dirY, step); else stopAutoScroll(); }, [findDropTarget, SCREEN_WIDTH, dayW, startAutoScroll, stopAutoScroll]);
  const handleDrop = useCallback(async (x, y) => { stopAutoScroll(); if (!draggedSlot) return; const sourceKey = draggedSlot.date+'|'+draggedSlot.hour; let targetDate, targetHour; if (Platform.OS === 'web' && x > 0 && y > 0) { if (ghostRef.current) ghostRef.current.style.display = 'none'; try { const elem = document.elementFromPoint(x, y); const slotElem = elem?.closest?.('[data-slot-date]'); if (slotElem) { targetDate = slotElem.getAttribute('data-slot-date'); targetHour = parseInt(slotElem.getAttribute('data-slot-hour'), 10); } } catch (e) {} if (ghostRef.current) ghostRef.current.style.display = 'flex'; } if (!targetDate || isNaN(targetHour)) { const targetKey = findDropTarget(x, y); if (targetKey && targetKey !== sourceKey) { const [d, h] = targetKey.split('|'); targetDate = d; targetHour = parseInt(h, 10); } } const targetKey = targetDate && !isNaN(targetHour) ? targetDate+'|'+targetHour : null; if (targetDate && !isNaN(targetHour) && targetKey !== sourceKey) { try { await api.swapEvents({ date1: draggedSlot.date, hour1: draggedSlot.hour, date2: targetDate, hour2: targetHour }); loadWeek(); } catch (err) { Alert.alert('Błąd', 'Nie udało się przenieść: ' + err.message); } } setDraggedSlot(null); setDragOver(null); }, [draggedSlot, findDropTarget, loadWeek]);
  const handleDelete = useCallback(async (date, hour, ev) => { try { await api.deleteCalendarEvent(date, hour); loadWeek(); } catch (e) { Alert.alert('Błąd', 'Nie udało się usunąć: ' + e.message); } }, [loadWeek]);
  function getEvent(dayIdx, hour) { const date = new Date(monday.getTime() + dayIdx * 86400000); return events.find(e => e.event_date === date.toISOString().slice(0, 10) && e.event_hour === hour); }
  const todayDayIdx = Math.min(5, Math.floor((today.getTime() - monday.getTime()) / 86400000));
  function onHorizontalScroll(e) { const x = e.nativeEvent.contentOffset.x; scrollX.current = x; headerScrollRef.current?.scrollTo?.({ x, animated: false }); }
  function onVerticalScroll(e) { scrollY.current = e.nativeEvent.contentOffset.y; }

  return (<View style={styles.container}>
    <View style={styles.iosHeader}>
      <TouchableOpacity style={styles.headerBtn} onPress={() => navigation.navigate('MenuModal')}><Ionicons name="menu" size={22} color={COLORS.text} /></TouchableOpacity>
      <View style={styles.dateNav}>
        <TouchableOpacity onPress={prevWeek} style={styles.navBtn}><Ionicons name="chevron-back" size={18} color={C.accent} /></TouchableOpacity>
        <TouchableOpacity style={styles.dateLabel} onPress={() => isCurrentWeek ? setShowMonth(true) : goToday()}><Text style={styles.dateText}>{weekLabel} — {saturdayLabel}</Text><Ionicons name="chevron-down" size={14} color={COLORS.textSecondary} style={{ marginLeft: 4 }} /></TouchableOpacity>
        <TouchableOpacity onPress={nextWeek} style={styles.navBtn}><Ionicons name="chevron-forward" size={18} color={C.accent} /></TouchableOpacity>
      </View>
      <TouchableOpacity style={styles.headerBtn} onPress={() => { if (viewMode === 'week') setMonday(getMonday(today)); setViewMode(viewMode === 'week' ? 'day' : 'week'); }}><Ionicons name={viewMode === 'week' ? 'calendar-outline' : 'list-outline'} size={20} color={C.accent} /></TouchableOpacity>
    </View>

    <View style={styles.headerRow}>
      <View style={[styles.hourCell, { borderBottomWidth: 0, backgroundColor: COLORS.surface }]}><TouchableOpacity style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }} onPress={() => isCurrentWeek ? setShowMonth(true) : goToday()}><Text style={{ color: C.accent, fontSize: 14, fontWeight: '800' }}>{isCurrentWeek ? 'K' : '⟲'}</Text></TouchableOpacity></View>
      <ScrollView horizontal ref={headerScrollRef} showsHorizontalScrollIndicator={false} scrollEnabled={false} style={{ flex: 1 }}>{DAYS.map((day, idx) => { const date = new Date(monday.getTime() + idx * 86400000); const isToday = today.toDateString() === date.toDateString(); return (<TouchableOpacity key={day} style={[styles.dayCell, isToday && styles.todayCell, { width: dayW }]} onPress={() => !editMode && navigation.navigate('Training', { date: date.toISOString().slice(0, 10) })}><Text style={[styles.dayText, isToday && styles.todayText]}>{day}</Text><Text style={[styles.dayNum, isToday && styles.todayText]}>{date.getDate()}</Text></TouchableOpacity>); })}</ScrollView>
    </View>

    <ScrollView ref={vScrollRef} showsVerticalScrollIndicator={false} style={{ flex: 1, backgroundColor: COLORS.surface }} contentContainerStyle={{ paddingBottom: 130 }} scrollEnabled={!isDragging} onScroll={onVerticalScroll} scrollEventThrottle={16}>
      <View style={{ flexDirection: 'row' }}>
        <View style={{ width: HOUR_W }}>{HOURS.map(hour => (<View key={hour} style={styles.hourCell}><Text style={styles.hourText}>{hour}:00</Text></View>))}</View>
        <ScrollView ref={hGridRef} horizontal showsHorizontalScrollIndicator={false} onScroll={onHorizontalScroll} scrollEventThrottle={16} style={{ flex: 1 }} scrollEnabled={!isDragging}>
          <View ref={gridBoxRef} onLayout={measureGrid}>{HOURS.map(hour => (<View key={hour} style={styles.gridRow}>{DAYS.map((dayLabel, dayIdx) => { if (viewMode === 'day' && dayIdx !== todayDayIdx) return null; const ev = getEvent(dayIdx, hour); const date = new Date(monday.getTime() + dayIdx * 86400000); const dateStr = date.toISOString().slice(0, 10); const slotKey = dateStr+'|'+hour; return (<CalendarSlot key={dayIdx+'-'+hour} dayIdx={dayIdx} hour={hour} ev={ev} dateStr={dateStr} dayW={dayW} editMode={editMode} navigation={navigation} onDelete={handleDelete} onDragStart={handleDragStart} onDragMove={handleDragMove} onDrop={handleDrop} onSlotLayout={registerSlotLayout} isDragged={draggedSlot?.date === dateStr && draggedSlot?.hour === hour} isDragOver={dragOver === slotKey} accent={C.accent} styles={styles} />); })}</View>))}</View>
        </ScrollView>
      </View>
    </ScrollView>

    <View style={styles.iosBottom}>
      <TouchableOpacity style={[styles.bottomBtn, !editMode && { backgroundColor: C.accent + '20', borderRadius: 12 }]} onPress={() => setEditMode(false)} activeOpacity={0.6}><MaterialCommunityIcons name="dog" size={22} color={!editMode ? C.accent : COLORS.textMuted} /><Text style={[styles.bottomText, !editMode && { color: C.accent }]}>HOME</Text></TouchableOpacity>
      <TouchableOpacity style={[styles.bottomBtn, editMode && { backgroundColor: C.accent + '20', borderRadius: 12 }]} onPress={() => setEditMode(!editMode)} activeOpacity={0.6}><Ionicons name="create" size={20} color={editMode ? C.accent : COLORS.textMuted} /><Text style={[styles.bottomText, editMode && { color: C.accent }]}>EDYCJA</Text></TouchableOpacity>
      <View style={styles.versionBadge}><Text style={styles.versionText}>v1.0.10</Text></View>
    </View>

    {draggedSlot && Platform.OS === 'web' && (<div ref={ghostRef} style={{ position: 'fixed', left: draggedSlot.x + 12, top: draggedSlot.y + 12, width: dayW - 4, height: CELL_H - 4, backgroundColor: C.accent, borderRadius: '10px', display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'center', pointerEvents: 'none', zIndex: 9999, boxShadow: '0 8px 16px rgba(0,0,0,0.3)', transform: 'rotate(2deg)', opacity: 0.9, border: '1px solid '+C.accent }}><span style={{ color: '#0d1117', fontSize: '11px', fontWeight: '700', textAlign: 'center', fontFamily: 'sans-serif' }}>{draggedSlot.ev?.clients?.name || '—'}</span><span style={{ color: 'rgba(13,17,23,0.8)', fontSize: '10px', fontWeight: '600', textAlign: 'center', marginTop: '2px', fontFamily: 'sans-serif' }}>{draggedSlot.ev?.workout_types?.name || ''}</span></div>)}

    <MonthPopup visible={showMonth} onClose={() => setShowMonth(false)} currentMonday={monday} onSelect={(newMonday) => setMonday(newMonday)} accent={C.accent} styles={styles} />
  </View>);
}

function makeStyles(accent) { return StyleSheet.create({
  container: { flex: 1, backgroundColor: COLORS.background },
  iosHeader: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', backgroundColor: COLORS.surface, paddingHorizontal: 16, paddingTop: 55, paddingBottom: 12, borderBottomWidth: 1, borderColor: COLORS.border },
  headerBtn: { width: 40, height: 40, borderRadius: 20, justifyContent: 'center', alignItems: 'center' },
  dateNav: { flexDirection: 'row', alignItems: 'center', gap: 4 },
  navBtn: { width: 36, height: 36, borderRadius: 18, justifyContent: 'center', alignItems: 'center' },
  dateLabel: { flexDirection: 'row', alignItems: 'center', backgroundColor: COLORS.surfaceLight, borderRadius: 20, paddingHorizontal: 14, paddingVertical: 8 },
  dateText: { color: COLORS.text, fontSize: 14, fontWeight: '700' },
  headerRow: { flexDirection: 'row', height: CELL_H, backgroundColor: COLORS.surface, borderBottomWidth: 2, borderColor: COLORS.border },
  dayCell: { height: CELL_H, alignItems: 'center', justifyContent: 'center' },
  todayCell: { backgroundColor: accent + '1a' },
  dayText: { color: COLORS.textSecondary, fontSize: 11, fontWeight: '600' },
  dayNum: { color: COLORS.text, fontSize: 14, fontWeight: '700', marginTop: 2 },
  todayText: { color: accent },
  hourCell: { width: HOUR_W, height: CELL_H, justifyContent: 'center', alignItems: 'center', borderRightWidth: 1, borderBottomWidth: 1, borderColor: COLORS.border, backgroundColor: COLORS.background },
  hourText: { color: COLORS.textMuted, fontSize: 10 },
  gridRow: { flexDirection: 'row', height: CELL_H },
  slot: { height: CELL_H - 4, justifyContent: 'center', alignItems: 'center', marginVertical: 2, marginHorizontal: 1, borderRadius: 10, backgroundColor: COLORS.surface, borderWidth: 1, borderColor: COLORS.border },
  eventText: { fontSize: 11, fontWeight: '700', textAlign: 'center' },
  iosBottom: { position: 'absolute', bottom: 0, left: 0, right: 0, flexDirection: 'row', justifyContent: 'center', gap: 40, backgroundColor: COLORS.surface, paddingVertical: 10, paddingBottom: 35, borderTopWidth: 1, borderColor: COLORS.border, zIndex: 100 },
  bottomBtn: { alignItems: 'center', gap: 2, paddingHorizontal: 16, paddingVertical: 6 },
  bottomText: { fontSize: 10, fontWeight: '700', color: COLORS.textMuted },
  versionBadge: { position: 'absolute', right: 12, bottom: 28 },
  versionText: { color: COLORS.textMuted, fontSize: 9, fontWeight: '600' },
  popupOverlay: { position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, zIndex: 200 },
  popupCard: { position: 'absolute', top: 100, left: 8, backgroundColor: COLORS.surface, borderRadius: 16, padding: 14, borderWidth: 1, borderColor: COLORS.border, width: 280, shadowColor: '#000', shadowOffset: { width: 0, height: 8 }, shadowOpacity: 0.4, shadowRadius: 16, elevation: 10 },
  popupNav: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 },
  popupMonth: { fontSize: 14, fontWeight: '700' },
  popupWeekdays: { flexDirection: 'row', marginBottom: 2 },
  popupWd: { width: 36, textAlign: 'center', color: COLORS.textMuted, fontSize: 10, fontWeight: '600' },
  popupWeek: { flexDirection: 'row', marginBottom: 2 },
  popupDay: { width: 36, height: 30, justifyContent: 'center', alignItems: 'center', borderRadius: 6 },
  popupToday: { backgroundColor: accent + '25' },
  popupSelected: { backgroundColor: accent },
  popupDayText: { color: COLORS.text, fontSize: 12 },
  popupTodayText: { color: accent, fontWeight: '700' },
  popupSelectedText: { color: '#fff', fontWeight: '700' },
}); }

function CalendarScreenWrapper(props) {
  return <CalendarScreen {...props} />;
}
export default CalendarScreenWrapper;
